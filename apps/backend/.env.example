# Copia este archivo como .env y ajusta los valores. Nunca subas .env al repositorio.

NODE_ENV=development
HOST=0.0.0.0
PORT=3000
LOG_LEVEL=debug

# PostgreSQL de desarrollo (docker compose). Se publica en 55432 para no chocar con
# instalaciones locales de PostgreSQL que suelen ocupar 5432/5433.
DATABASE_URL=postgresql://karbon:karbon@localhost:55432/karbon?schema=public

# Orígenes extra permitidos por CORS, separados por coma. Los orígenes de la red
# privada (localhost, 10.x, 172.16-31.x, 192.168.x) siempre se permiten.
CORS_ORIGINS=

# Documentación interactiva en /api/docs
SWAGGER_ENABLED=true

# Seed: credenciales del administrador inicial y datos de demostración
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=Admin123*
SEED_DEMO_DATA=true

# Autenticación: secreto de firma de los JWT (mínimo 32 caracteres). En producción lo genera
# el instalador. Genera uno con: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=cambia-este-secreto-de-desarrollo-por-uno-aleatorio
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_DAYS=30

# Datos locales: imágenes, respaldos y certificados
DATA_DIR=./data

# Modo del seed de demostración: RESTAURANT o BAR
SEED_BUSINESS_MODE=RESTAURANT

# Puertos de Vite (npm run dev): Configuración → Celulares muestra el QR de la app de meseros y
# del tablero de cocina con la IP de este equipo. El programa instalado no los usa.
DEV_MOBILE_PORT=5174
DEV_DESKTOP_PORT=5173
